# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/barangay_kiosk

# Supabase (optional, for OTP)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Semaphore SMS (Philippines)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BARANGAY

# OTP
USE_SUPABASE_OTP=false
