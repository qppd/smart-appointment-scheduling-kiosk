NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Semaphore SMS API Configuration
SEMAPHORE_API_KEY=your_semaphore_api_key_here
# Semaphore sender name (max 11 characters for alphanumeric, or phone number for numeric)
SEMAPHORE_SENDER_NAME=SEMAFOR
# Optional: Semaphore API base URL (defaults to https://api.semaphore.co/api/v4)
# SEMAPHORE_BASE_URL=https://api.semaphore.co/api/v4
# Optional: Request timeout in milliseconds (defaults to 12000)
# SEMAPHORE_TIMEOUT_MS=12000
# Optional: Maximum number of retries for transient failures (defaults to 2, max 5)
# SEMAPHORE_MAX_RETRIES=2
