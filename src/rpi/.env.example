# RPi Firebase Config (pyrebase4)
KIOSK_FIREBASE_API_KEY=your_firebase_api_key
KIOSK_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
KIOSK_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
KIOSK_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Kiosk service account (Firebase Auth email/password)
KIOSK_EMAIL=kiosk@yourdomain.com
KIOSK_PASSWORD=your_secure_password

# Serial port for ESP32 (micro USB)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
